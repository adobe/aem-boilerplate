        "https://www.bobcard.co.in/credit-card-types/eterna"
      ],
      "coverageGaps": [],
      "description": "Credit card product detail page with hero banner, card benefits, additional benefits carousel, application guidelines, and FAQ sections",
      "blocks": [
        {
          "name": "hero-eterna",

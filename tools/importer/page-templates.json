            ".CardBannersWrapp article.card_banner",
            "article.card_banner"
          ]
        },
        {
          "name": "cards-benefit",
          "instances": [
            ".CardBenefitesWrapp article.benefit-eterna"
          ]
        },
        {
          "name": "columns-product",
          "instances": [
            "article.feature-benefit"
          ]
        },
        {
          "name": "cards-additional",
          "instances": [
            "article.benefit-eterna.additional-benefit"
          ]
        },
        {
          "name": "cards-steps",
          "instances": [
            "article.document-req"
          ]
        },
        {
          "name": "hero-cta",
          "instances": [
            "article.transaction-banner"
          ]
        },
        {
          "name": "accordion-faq",
          "instances": [
            ".faq-pg article.faq-wrapper",
            "article.faq-wrapper"
          ]
        }
      ],
      "sections": [
